# Environment Configuration Example
# Copy this file to .env and update with your values

# Google Cloud Project ID
GCP_PROJECT=ps-deals-tracker

# Firestore Emulator (for local development)
# Uncomment this line when running locally with emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Price Source Adapter Configuration
# Set to "true" to use mock data, "false" to use PSN adapter
USE_MOCK_ADAPTER=true

# PSN API Configuration (required if USE_MOCK_ADAPTER=false)
# PSN_API_KEY=your_psn_api_key_here

# Processing Configuration
# Number of games to process concurrently
BATCH_SIZE=10
